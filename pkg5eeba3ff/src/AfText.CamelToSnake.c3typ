/**
 * AfText.CamelToSnake is a stateless utility service (declared here as a plain `type` because the
 * platform parser rejects the `service type` keyword combination; it is used purely as a
 * stateless service in the "service" sense) for converting camelCase (or PascalCase) identifiers
 * into snake_case.
 *
 * Contract of {@link AfText.CamelToSnake#convert}: `input` is a required string.
 * - A lowercase letter or digit immediately followed by an uppercase letter gets an underscore
 *   inserted between them (e.g. `fooBar` -> `foo_bar`).
 * - A run of two or more consecutive uppercase letters followed by a lowercase letter is split
 *   before the last uppercase letter of the run (e.g. `HTTPServer` -> `http_server`).
 * - The entire result is lower-cased.
 * - Leading/trailing whitespace is preserved as-is (not trimmed); internal whitespace and any
 *   existing underscores or hyphens are left untouched aside from the case conversion.
 * - An already-snake_case or empty string is returned unchanged (aside from lower-casing).
 * `input` is never mutated (strings are immutable in JS regardless).
 *
 * Examples:
 * - `convert("fooBar")` -> `"foo_bar"`
 * - `convert("FooBarBaz")` -> `"foo_bar_baz"`
 * - `convert("HTTPServer")` -> `"http_server"`
 * - `convert("already_snake")` -> `"already_snake"`
 * - `convert("")` -> `""`
 */
type AfText.CamelToSnake {

  /**
   * Converts a camelCase or PascalCase string into snake_case.
   *
   * @param input A required string in camelCase, PascalCase, or already snake_case form.
   * @return The lower-cased snake_case form of `input`, with underscores inserted at
   *     lower-to-upper and uppercase-run-to-lowercase boundaries.
   */
  convert: function(input: !string): !string js-rhino
}
