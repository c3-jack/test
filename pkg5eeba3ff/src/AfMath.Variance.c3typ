/**
 * Utility service exposing a population variance calculation.
 *
 * {@link AfMath.Variance#variance} computes the population variance (the
 * average of the squared deviations from the mean) of a non-empty list of
 * numbers. Note this is a stateless utility service; "service" here
 * describes its role, not a c3 `service type` declaration.
 */
type AfMath.Variance {

  /**
   * Computes the population variance of {@link values}.
   *
   * Contract:
   * - `values` must contain at least one element; behavior for an empty
   *   list is undefined (implementation returns `NaN`).
   * - Computes the mean of `values`, then returns the average of the
   *   squared differences between each element and that mean (i.e. the
   *   population variance, dividing by `n`, not `n - 1`).
   * - A single-element list always yields `0`.
   *
   * @param values the non-empty list of numbers to compute the variance of
   * @return the population variance of `values`
   */
  variance: function(values: ![double]): !double js-rhino
}
