/**
 * Utility service exposing indentation of multi-line text.
 *
 * {@link AfText.IndentLines#indent} prepends a fixed number of spaces to
 * every line of an input string, including blank lines.
 */
service type AfText.IndentLines {

  /**
   * Prepends `spaces` space characters to the start of every line of
   * `input`.
   *
   * Contract:
   * - `input` is split into lines on `\n` (a leading `\r` on each line, if
   *   present, is preserved as part of the line content) and every line —
   *   including empty lines — is prefixed with `spaces` space characters.
   * - The lines are rejoined with `\n`, so the number of lines and the
   *   position of line breaks in the output exactly match the input.
   * - `spaces` must be a non-negative integer; if it is negative, an Error
   *   is thrown. A `spaces` value of `0` returns `input` unchanged.
   * - If `input` is `null` or `undefined`, an Error is thrown.
   *
   * @param input the text to indent, one or more lines separated by `\n`
   * @param spaces the number of space characters to prepend to each line
   * @return `input` with `spaces` leading spaces added to every line
   */
  indent: function(input: !string, spaces: !int): !string js-rhino
}
