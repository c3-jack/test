/**
 * AfText.TitleCase is a stateless utility service (declared here as a plain `type` because the
 * platform parser rejects the `service type` keyword combination; it is used purely as a
 * stateless service in the "service" sense) for converting a string to title case.
 *
 * Contract of {@link AfText.TitleCase#convert}: `input` is the required string to convert. The
 * string is split on whitespace, and the first alphabetic character of each resulting word is
 * upper-cased while the remainder of that word is lower-cased; characters that are not letters
 * (digits, punctuation) are left untouched. Existing whitespace (including runs of multiple
 * spaces) is preserved verbatim in the output. An empty string returns an empty string.
 *
 * Examples:
 * - `convert('hello world')` -> `'Hello World'`
 * - `convert('HELLO WORLD')` -> `'Hello World'`
 * - `convert('mc3 io-t')` -> `'Mc3 Io-t'`
 * - `convert('')` -> `''`
 * - `convert('  multiple   spaces ')` -> `'  Multiple   Spaces '`
 */
type AfText.TitleCase {

  /**
   * Converts `input` to title case: the first letter of each whitespace-delimited word is
   * upper-cased and the rest of that word is lower-cased. Non-letter characters and existing
   * whitespace are preserved as-is.
   *
   * @param input The required string to convert to title case.
   * @return `input` converted to title case.
   */
  convert: function(input: !string): !string js-rhino
}
