/**
 * AfText.TitleCase is a stateless utility service (declared here as a plain `type` because the
 * platform parser rejects the `service type` keyword combination; it is used purely as a
 * stateless service in the "service" sense) for converting an arbitrary string to title case.
 *
 * Contract of {@link AfText.TitleCase#convert}: `input` is a required string. The function
 * splits `input` on whitespace, and for each resulting word capitalizes the first alphabetic
 * character and lower-cases the remainder of the word, leaving the original whitespace runs
 * between words unchanged. Words containing no alphabetic characters (e.g. purely numeric or
 * punctuation tokens) are returned unchanged aside from lower-casing. An empty string returns an
 * empty string.
 *
 * Examples:
 * - `convert("hello world")` -> `"Hello World"`
 * - `convert("HELLO WORLD")` -> `"Hello World"`
 * - `convert("the QUICK brown FOX")` -> `"The Quick Brown Fox"`
 * - `convert("  multiple   spaces  ")` -> `"  Multiple   Spaces  "`
 * - `convert("already-hyphenated")` -> `"Already-hyphenated"`
 * - `convert("")` -> `""`
 */
type AfText.TitleCase {

  /**
   * Converts the given string to title case: the first letter of each whitespace-separated word
   * is upper-cased and the rest of that word is lower-cased; whitespace between words is
   * preserved as-is.
   *
   * @param input The required string to convert.
   * @return The title-cased version of `input`.
   */
  convert: function(input: !string): !string js-rhino
}
