/**
 * AfColl.ParseCsvLine is a stateless utility service (declared here as a plain `type` because the
 * platform parser rejects the `service type` keyword combination; it is used purely as a
 * stateless service in the "service" sense) for parsing a single line of CSV text into its
 * component fields.
 *
 * Contract of {@link AfColl.ParseCsvLine#parse}: `line` is a required string containing exactly
 * one CSV record (no embedded newlines that represent additional records). Fields are separated
 * by commas (`,`). A field may optionally be wrapped in double quotes (`"`); a quoted field may
 * contain commas and newline characters literally, and any embedded double quote is represented
 * as two consecutive double quotes (`""`), which are unescaped to a single `"` in the returned
 * value. Unquoted fields are returned exactly as written, including surrounding whitespace.
 * Leading/trailing whitespace around a quoted field's quotes is not part of the field.
 *
 * The returned array always has one more element than the number of unquoted, unescaped commas
 * plus quoted-field commas encountered — i.e. one element per field, in order. An empty `line`
 * returns a single-element array containing the empty string (consistent with a one-field, empty
 * record), matching how a single trailing comma produces a trailing empty field.
 *
 * Examples:
 * - `parse("a,b,c")` -> `["a", "b", "c"]`
 * - `parse('a,"b,c",d')` -> `["a", "b,c", "d"]`
 * - `parse('a,"say ""hi""",c')` -> `["a", 'say "hi"', "c"]`
 * - `parse("")` -> `[""]`
 * - `parse("a,,c")` -> `["a", "", "c"]`
 */
type AfColl.ParseCsvLine {

  /**
   * Parses a single CSV line into its component fields, honoring double-quoted fields (which may
   * contain commas) and `""`-escaped quotes within them.
   *
   * @param line The required raw CSV line text to parse.
   * @return The ordered list of field values contained in `line`.
   */
  parse: function(line: !string): ![string] js-rhino
}
