/**
 * AfNet.PortOf is a stateless utility service for extracting the numeric network port that a
 * URL resolves to, so callers don't have to hand-parse authority strings before comparing,
 * bucketing, or logging by port.
 *
 * Contract of {@link AfNet.PortOf#port}: `url` is a full URL string (e.g.
 * `"https://host:8443/path"`). It is parsed only far enough to recover the `scheme`, an optional
 * explicit `:port` in the authority, and the `host`; the path, query string, and fragment are
 * ignored.
 *
 * - If the authority contains an explicit port (`host:port`), that port is returned.
 * - Otherwise the scheme's well-known default port is returned: `80` for `http`, `443` for
 *   `https`, `21` for `ftp`, `22` for `ssh`. Matching on scheme is case-insensitive.
 * - If `url` has no recognizable scheme, no host, or an unrecognized schemeless default and no
 *   explicit port, `-1` is returned rather than throwing — callers can treat `-1` as "unknown".
 *
 * Examples:
 * - `port("https://x.com:8443/a")` -> `8443`
 * - `port("https://x.com/a")` -> `443`
 * - `port("http://x.com/a")` -> `80`
 * - `port("ftp://x.com")` -> `21`
 * - `port("x.com/a")` -> `-1` (no scheme)
 */
type AfNet.PortOf {

  /**
   * Returns the numeric port that `url` resolves to: the explicit `:port` in the authority when
   * present, otherwise the well-known default port for `url`'s scheme (`80` http, `443` https,
   * `21` ftp, `22` ssh; scheme matching is case-insensitive). Returns `-1` when `url` has no
   * parseable scheme/host or the scheme has no known default and no explicit port was given.
   * Never throws.
   *
   * @param url The full URL to inspect, e.g. `"https://host:8443/path"`. Treated as opaque text;
   *   only the scheme and authority are parsed, the path/query/fragment are ignored.
   * @return The resolved numeric port, or `-1` if it cannot be determined.
   */
  port: function(url: !string): !int js-rhino
}
