/**
 * Utility service exposing collection-flattening.
 *
 * {@link AfColl.Flatten#flatten} recursively flattens an arbitrarily nested
 * array into a single, flat array.
 */
service type AfColl.Flatten {

  /**
   * Recursively flattens a nested array into a single flat array.
   *
   * Contract:
   * - `items` is expected to be an array; elements may themselves be arrays,
   *   nested to any depth.
   * - Non-array elements are copied into the result as-is, in their
   *   original left-to-right order.
   * - Array elements are recursively flattened and their contents spliced
   *   in-place (i.e. the nesting level is fully removed, not just one
   *   level).
   * - Empty arrays (including nested empty arrays) contribute no elements
   *   to the result.
   * - If `items` is itself empty, an empty array is returned.
   *
   * @param items the (possibly nested) array to flatten
   * @return a new, single-level array containing all non-array elements of
   *   `items`, in their original order
   */
  flatten: function(items: !any): !any js-rhino
}
