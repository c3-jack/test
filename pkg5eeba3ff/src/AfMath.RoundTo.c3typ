/**
 * AfMath.RoundTo is a stateless utility service (declared here as a plain `type` because the
 * platform parser rejects the `service type` keyword combination; it is used purely as a
 * stateless service in the "service" sense) for rounding a number to a fixed number of decimal
 * places.
 *
 * Contract of {@link AfMath.RoundTo#round}: `value` is the required number to round and `places`
 * is the required non-negative integer count of decimal places to keep. Rounding uses
 * "round half away from zero" semantics (e.g. `2.5` rounds to `3`, `-2.5` rounds to `-3`) applied
 * at the given decimal place, avoiding the binary floating-point drift that a naive
 * `Math.round(value * 10^places) / 10^places` can introduce (achieved by rounding via the
 * decimal-shifted string representation rather than raw float multiplication). `places` of `0`
 * rounds to the nearest integer. A negative `places` is treated as `0` (i.e. rounds to the
 * nearest integer). The return value is always a `double`, never a formatted string.
 *
 * Examples:
 * - `round(1.005, 2)` -> `1.01`
 * - `round(2.5, 0)` -> `3`
 * - `round(-2.5, 0)` -> `-3`
 * - `round(123.456, -1)` -> `123` (negative `places` clamped to `0`)
 * - `round(10, 3)` -> `10`
 */
type AfMath.RoundTo {

  /**
   * Rounds `value` to `places` decimal places using round-half-away-from-zero semantics.
   *
   * @param value The required number to round.
   * @param places The required number of decimal places to round to. Negative values are
   *   clamped to `0` (rounds to the nearest integer).
   * @return `value` rounded to `places` decimal places.
   */
  round: function(value: !double, places: !int): !double js-rhino
}
