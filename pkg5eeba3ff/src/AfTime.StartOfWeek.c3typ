/**
 * AfTime.StartOfWeek is a stateless utility service (declared here as a plain `type` because
 * the platform parser rejects the `service type` keyword combination; it is used purely as a
 * stateless service in the "service" sense) for computing the start of the ISO week (Monday)
 * containing a given {@link DateTime}.
 *
 * Contract of {@link AfTime.StartOfWeek#startOf}: `date` is a required `datetime`. The function
 * returns the `datetime` at midnight (00:00:00, same timezone as `date`) on the Monday of the
 * week that contains `date`, per the ISO-8601 week definition (weeks start on Monday, `dayOfWeek()`
 * returns 1 for Monday through 7 for Sunday). `date` is never mutated.
 *
 * Examples:
 * - `startOf(<Wed 2024-01-03 15:30:00Z>)` -> `<Mon 2024-01-01 00:00:00Z>`
 * - `startOf(<Mon 2024-01-01 09:00:00Z>)` -> `<Mon 2024-01-01 00:00:00Z>` (already Monday, still truncated to midnight)
 * - `startOf(<Sun 2024-01-07 23:59:59Z>)` -> `<Mon 2024-01-01 00:00:00Z>`
 */
type AfTime.StartOfWeek {

  /**
   * Computes the start (midnight Monday) of the ISO week containing `date`.
   *
   * Uses `date.dayOfWeek()` (1=Monday .. 7=Sunday) to determine how many days to subtract to
   * reach the Monday of the same week, then truncates the time-of-day to midnight.
   *
   * @param date A required datetime to find the containing week's start for.
   * @return The datetime at midnight on the Monday of the week containing `date`.
   */
  startOf: function(date: !datetime): !datetime js-rhino
}
