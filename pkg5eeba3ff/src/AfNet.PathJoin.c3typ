/**
 * AfNet.PathJoin is a stateless utility service (declared here as a plain `type` because the
 * platform parser rejects the `service type` keyword combination; it is used purely as a
 * stateless service in the "service" sense) for joining path segments into a single
 * forward-slash-delimited path, similar in spirit to Node's `path.posix.join`.
 *
 * Contract of {@link AfNet.PathJoin#join}: `parts` is a required array of strings, each a path
 * segment (e.g. `['a', 'b', 'c']`). The segments are joined with a single `/` separator. Empty
 * string segments are skipped. Redundant slashes introduced by segments that already contain
 * leading/trailing slashes are collapsed to a single `/`, except that a single leading `/` is
 * preserved when the first non-empty segment starts with `/` (so absolute paths stay absolute).
 * Segments are not otherwise normalized (e.g. `..` and `.` are left as-is). `parts` is not
 * mutated.
 *
 * Examples:
 * - `join(['a', 'b', 'c'])` -> `'a/b/c'`
 * - `join(['/a/', '/b/', 'c'])` -> `'/a/b/c'`
 * - `join(['a', '', 'b'])` -> `'a/b'`
 * - `join([])` -> `''`
 */
type AfNet.PathJoin {

  /**
   * Joins `parts` into a single forward-slash-delimited path string.
   *
   * Concatenates all non-empty segments in order with `/` separators, collapsing any duplicate
   * slashes that result from segments already containing leading/trailing slashes. If the first
   * non-empty segment begins with `/`, the result preserves a single leading `/` so absolute
   * paths remain absolute. `parts` is not mutated.
   *
   * @param parts A required array of string path segments to join.
   * @return The joined path string.
   */
  join: function(parts: ![string]): !string js-rhino
}
