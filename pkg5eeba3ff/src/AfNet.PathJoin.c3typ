/**
 * AfNet.PathJoin is a stateless utility service (declared here as a plain `type` because the
 * platform parser rejects the `service type` keyword combination; it is used purely as a
 * stateless service in the "service" sense) for joining path segments into a single
 * forward-slash-delimited path, similar to POSIX path joining or Node's `path.posix.join`.
 *
 * Contract of {@link AfNet.PathJoin#join}: `parts` is a required array of strings, each an
 * individual path segment (e.g. `["a", "b", "c"]`). The segments are concatenated in order,
 * separated by a single `/`. Redundant slashes at the boundaries between segments are
 * collapsed to one, empty segments are skipped, and a trailing `/` is preserved only if the
 * final non-empty segment itself ends with `/`. The result never contains consecutive slashes
 * (`//`) introduced by the join itself. Leading `/` on the first segment is preserved (so
 * absolute paths stay absolute); leading/trailing slashes on interior segments are normalized
 * away.
 *
 * Examples:
 * - `join(["a", "b", "c"])` -> `"a/b/c"`
 * - `join(["a/", "/b", "c/"])` -> `"a/b/c/"`
 * - `join(["/a", "b"])` -> `"/a/b"`
 * - `join(["a", "", "b"])` -> `"a/b"`
 * - `join([])` -> `""`
 */
type AfNet.PathJoin {

  /**
   * Joins the given path segments into a single forward-slash-delimited path, collapsing
   * redundant slashes at segment boundaries and skipping empty segments.
   *
   * @param parts The required array of path segments to join, in order.
   * @return The joined path string.
   */
  join: function(parts: ![string]): !string js-rhino
}
