/**
 * Utility service exposing percent-change calculations.
 *
 * {@link AfMath.PercentChange#change} computes the relative change from an
 * initial (`from`) value to a final (`to`) value, expressed as a percentage.
 */
service type AfMath.PercentChange {

  /**
   * Computes the percentage change from {@link from} to {@link to}.
   *
   * Contract:
   * - Returns `((to - from) / from) * 100`.
   * - A positive result indicates an increase from `from` to `to`; a
   *   negative result indicates a decrease.
   * - Returns `0` when `from` and `to` are equal (and non-zero).
   * - If `from` is `0`, the result follows standard floating point division
   *   semantics: `Infinity` when `to` is greater than `0`, `-Infinity` when
   *   `to` is less than `0`, and `NaN` when `to` is also `0`.
   *
   * @param from the initial (baseline) value
   * @param to the final value
   * @return the percentage change from `from` to `to`
   */
  change: function(from: !double, to: !double): !double js-rhino
}
