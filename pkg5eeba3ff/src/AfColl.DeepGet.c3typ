/**
 * Utility service exposing a safe nested-property accessor for plain
 * objects and arrays.
 *
 * {@link AfColl.DeepGet#get} retrieves the value located at a dot/bracket
 * path within an arbitrarily nested object graph, returning `null` instead
 * of throwing when any segment of the path is missing.
 */
service type AfColl.DeepGet {

  /**
   * Retrieves the value at {@link path} within {@link obj}.
   *
   * Contract:
   * - `path` is a sequence of property names separated by `.`, with array
   *   indices written in bracket form, e.g. `"a.b[0].c"` or `"a.b.0.c"`.
   * - Traversal proceeds segment by segment starting from `obj`.
   * - If, at any point, the current value is `null`/`undefined` or the next
   *   segment does not exist on it, the function returns `null` rather than
   *   throwing.
   * - If `obj` is `null`/`undefined`, returns `null`.
   * - If the full path resolves successfully, returns the value found there
   *   (which may itself be `null`).
   * - `path` may be an empty string, in which case `obj` is returned
   *   unchanged.
   *
   * @param obj the object (or array) to traverse; may be `null`
   * @param path the dot/bracket-notation path to look up, e.g. `"a.b[0].c"`
   * @return the value found at `path`, or `null` if any segment is missing
   */
  get: function(obj: !any, path: !string): any js-rhino
}
