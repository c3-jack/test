/**
 * AfNet.RedactQuery is a stateless utility service for scrubbing sensitive query-string values
 * (API keys, tokens, session ids, etc.) out of a URL before it is logged, displayed, or stored.
 *
 * Contract of {@link AfNet.RedactQuery#redact}: `url` is the full URL (or path + query string)
 * to sanitize, and `keys` is a required array of query parameter names whose values must be
 * redacted. `url` is treated as opaque text and is never parsed as a `URL` object — only the
 * query-string segment (between `?` and an optional trailing `#fragment`) is touched; the
 * scheme/host/path and any fragment are passed through unchanged.
 *
 * Matching is exact and case-sensitive against the raw (not percent-decoded) parameter name.
 * Every occurrence of a matching parameter is redacted (repeated keys, e.g. `a=1&a=2`, are each
 * replaced), and a value-less parameter (e.g. `?token`) is rewritten as `token=REDACTED`.
 * Non-matching parameters, their order, and their original encoding are left untouched.
 *
 * If `url` has no `?` (no query string) or `keys` is empty, `url` is returned unchanged.
 *
 * Examples:
 * - `redact("https://x.com/a?token=abc&id=1", ["token"])` ->
 *   `"https://x.com/a?token=REDACTED&id=1"`
 * - `redact("https://x.com/a?id=1", ["token"])` -> `"https://x.com/a?id=1"` (no match)
 * - `redact("https://x.com/a", ["token"])` -> `"https://x.com/a"` (no query string)
 * - `redact("https://x.com/a?token", ["token"])` -> `"https://x.com/a?token=REDACTED"`
 * - `redact("https://x.com/a?token=1#frag", ["token"])` -> `"https://x.com/a?token=REDACTED#frag"`
 */
type AfNet.RedactQuery {

  /**
   * Redacts the values of the given query parameter `keys` out of `url`, returning a new URL
   * string with matching parameter values replaced by the literal `REDACTED` marker.
   *
   * Only the query-string portion of `url` (after `?`, before an optional `#fragment`) is
   * examined; splits it on `&` and, for each `name=value` (or bare `name`) segment, rewrites the
   * segment to `name=REDACTED` when `name` exactly matches an entry in `keys`. All other
   * segments, their relative order, and the scheme/host/path/fragment are left unchanged. `url`
   * is not mutated (strings are immutable) and no exception is thrown for a missing query
   * string or an empty `keys` list — `url` is simply returned as-is.
   *
   * @param url The full URL (or path + query string) to redact. Treated as opaque text.
   * @param keys A required array of query parameter names (case-sensitive, exact match against
   *   the raw/un-decoded name) whose values should be redacted. An empty array is a no-op.
   * @return `url` with the values of every matching query parameter replaced by `REDACTED`.
   */
  redact: function(url: !string, keys: ![string]): !string js-rhino
}
