/**
 * AfNet.JoinUrl is a stateless utility service for joining a base URL with a relative path
 * into a single well-formed URL string.
 *
 * Contract of {@link AfNet.JoinUrl#join}: it trims exactly one trailing slash from `base`
 * (if present) and exactly one leading slash from `path` (if present), then concatenates the
 * two with a single `/` separator. This guarantees exactly one `/` between the two parts
 * regardless of how many slashes (zero or one) are supplied on either side. It does not
 * collapse interior slashes, resolve `.`/`..` segments, or otherwise normalize the URL beyond
 * the join point.
 *
 * Examples:
 * - `join('http://a.com/', '/b')` -> `'http://a.com/b'`
 * - `join('http://a.com', 'b')` -> `'http://a.com/b'`
 * - `join('http://a.com/', 'b')` -> `'http://a.com/b'`
 * - `join('http://a.com', '/b')` -> `'http://a.com/b'`
 *
 * Both `base` and `path` are required strings.
 */
type AfNet.JoinUrl {

  /**
   * Joins a base URL and a relative path into a single well-formed URL string.
   *
   * Trims exactly one trailing slash from `base` (if present) and exactly one leading slash
   * from `path` (if present), then concatenates the results with a single `/` separator so
   * the returned URL always has exactly one `/` at the join point.
   *
   * @param base The base URL, e.g. `'http://a.com/'` or `'http://a.com'`. Required.
   * @param path The relative path to append, e.g. `'/b'` or `'b'`. Required.
   * @return The joined URL string, e.g. `'http://a.com/b'`.
   */
  join: function(base: !string, path: !string): !string js-rhino
}
