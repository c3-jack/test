/**
 * AfNet.IsIpv4 is a stateless utility service (declared here as a plain `type` because the
 * platform parser rejects the `service type` keyword combination; it is used purely as a
 * stateless service in the "service" sense) for validating whether a string is a syntactically
 * correct IPv4 dotted-quad address.
 *
 * Contract of {@link AfNet.IsIpv4#check}: `input` is a required string. The function returns
 * `true` if and only if `input` consists of exactly four decimal octets separated by `.`, where
 * each octet is composed only of digits, contains no leading zero (unless the octet is exactly
 * `"0"`), and falls in the range 0-255. Any other input — wrong number of segments, non-digit
 * characters, out-of-range values, leading zeros, leading/trailing/extra whitespace, or an empty
 * string — returns `false`. `input` is never mutated.
 *
 * Examples:
 * - `check("192.168.0.1")` -> `true`
 * - `check("255.255.255.255")` -> `true`
 * - `check("0.0.0.0")` -> `true`
 * - `check("256.1.1.1")` -> `false` (octet out of range)
 * - `check("192.168.0.01")` -> `false` (leading zero)
 * - `check("192.168.0")` -> `false` (too few segments)
 * - `check("192.168.0.1.5")` -> `false` (too many segments)
 * - `check("abc.def.ghi.jkl")` -> `false` (non-numeric)
 * - `check("")` -> `false`
 */
type AfNet.IsIpv4 {

  /**
   * Checks whether `input` is a syntactically valid IPv4 dotted-quad address.
   *
   * Splits `input` on `.` and requires exactly four segments, each consisting only of digits,
   * with no leading zero unless the segment is exactly `"0"`, and each parsing to an integer in
   * the range 0-255. `input` is not mutated.
   *
   * @param input A required string to validate as an IPv4 address.
   * @return `true` if `input` is a valid IPv4 dotted-quad address, `false` otherwise.
   */
  check: function(input: !string): !boolean js-rhino
}
