/**
 * AfColl.SafeJsonLoad is a stateless utility service for parsing a JSON-encoded string without
 * throwing when the string is missing, malformed, or otherwise not valid JSON.
 *
 * Contract of {@link AfColl.SafeJsonLoad#parse}: `input` is the string to parse as JSON.
 * `fallback` is an optional value to return if `input` cannot be parsed as valid JSON; if
 * `fallback` is not supplied, `undefined` is used.
 *
 * If `input` is `null`/`undefined`, or is not a non-empty string, or fails to parse as JSON
 * (e.g. it is truncated, uses single quotes, or contains trailing commas), {@link
 * AfColl.SafeJsonLoad#parse} returns `fallback` instead of throwing. Otherwise it returns the
 * value produced by parsing `input` (object, array, string, number, boolean, or `null`).
 *
 * Examples:
 * - `parse('{"a":1}')` -> `{a: 1}`
 * - `parse('[1,2,3]')` -> `[1, 2, 3]`
 * - `parse('not json')` -> `undefined`
 * - `parse('not json', {})` -> `{}`
 * - `parse(null, [])` -> `[]`
 */
type AfColl.SafeJsonLoad {

  /**
   * Safely parses `input` as JSON, returning the parsed value or `fallback` (default
   * `undefined`) if `input` is not a valid JSON string.
   *
   * Never throws: any parse failure (invalid syntax, non-string/empty input, etc.) is caught
   * and `fallback` is returned instead.
   *
   * @param input The string to parse as JSON. May be `null`/`undefined` or malformed.
   * @param fallback The value to return when `input` cannot be parsed as JSON. Defaults to
   *   `undefined` when omitted.
   * @return The value parsed from `input`, or `fallback` if parsing failed.
   */
  parse: function(input: string, fallback: any): any js-rhino
}
