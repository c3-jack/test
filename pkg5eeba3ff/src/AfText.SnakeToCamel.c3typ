/**
 * AfText.SnakeToCamel is a stateless utility service (declared here as a plain `type` because
 * the platform parser rejects the `service type` keyword combination; it is used purely as a
 * stateless service in the "service" sense) for converting snake_case (or kebab-case) identifiers
 * into camelCase strings.
 *
 * Contract of {@link AfText.SnakeToCamel#convert}: `input` is a required string containing zero
 * or more words separated by underscores (`_`) and/or hyphens (`-`). The function lower-cases the
 * first word and capitalizes the first letter of every subsequent word, joining them with no
 * separator, to produce a camelCase identifier. Empty segments produced by consecutive separators
 * (or leading/trailing separators) are skipped. `input` is never mutated.
 *
 * Examples:
 * - `convert("snake_case_value")` -> `"snakeCaseValue"`
 * - `convert("already-kebab-case")` -> `"alreadyKebabCase"`
 * - `convert("SCREAMING_SNAKE_CASE")` -> `"screamingSnakeCase"`
 * - `convert("single")` -> `"single"`
 * - `convert("")` -> `""`
 */
type AfText.SnakeToCamel {

  /**
   * Converts a snake_case (or kebab-case) `input` string into camelCase.
   *
   * Splits `input` on runs of `_` and `-`, lower-cases the first non-empty segment in full,
   * capitalizes the first letter of each subsequent non-empty segment (lower-casing the rest of
   * that segment), and concatenates the results with no separator. `input` is not mutated.
   *
   * @param input A required string in snake_case or kebab-case form to convert.
   * @return The camelCase representation of `input`.
   */
  convert: function(input: !string): !string js-rhino
}
