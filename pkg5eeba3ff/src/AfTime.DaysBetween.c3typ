/**
 * AfTime.DaysBetween is a stateless utility service (declared here as a plain `type` because
 * the platform parser rejects the `service type` keyword combination; it is used purely as a
 * stateless service in the "service" sense) for computing the whole number of calendar days
 * between two datetimes.
 *
 * Contract of {@link AfTime.DaysBetween#between}: both `a` and `b` are required datetimes.
 * The result is `b - a` measured in whole days, truncated toward zero (i.e. partial-day
 * remainders are discarded, not rounded). If `b` is earlier than `a`, the result is negative.
 * If `a` and `b` fall on the same calendar instant (or within the same 24-hour span measured
 * from `a`), and `b >= a`, the result is a non-negative integer; passing the same instant for
 * both returns `0`.
 *
 * Examples (illustrative, using date-only instants at midnight UTC):
 * - `between(2024-01-01, 2024-01-02)` -> `1`
 * - `between(2024-01-01, 2024-01-01)` -> `0`
 * - `between(2024-01-02, 2024-01-01)` -> `-1`
 * - `between(2024-01-01, 2024-01-10T12:00:00)` -> `9` (partial day truncated)
 */
type AfTime.DaysBetween {

  /**
   * Computes the whole number of days from `a` to `b`, truncated toward zero.
   *
   * @param a The starting datetime.
   * @param b The ending datetime.
   * @return The number of whole days between `a` and `b` (positive if `b` is after `a`,
   *         negative if `b` is before `a`, zero if they are the same instant).
   */
  between: function(a: !datetime, b: !datetime): !int js-rhino
}
