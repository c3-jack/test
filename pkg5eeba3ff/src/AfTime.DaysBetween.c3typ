/**
 * AfTime.DaysBetween is a stateless utility service (declared here as a plain `type` because
 * the platform parser rejects the `service type` keyword combination; it is used purely as a
 * stateless service in the "service" sense) for computing the number of whole days that elapse
 * between two {@link DateTime} values.
 *
 * Contract of {@link AfTime.DaysBetween#between}: `a` and `b` are both required `datetime`
 * values. The result is the number of whole 24-hour days between them, computed as
 * `floor(abs(DateTime.deltaSeconds(a, b)) / 86400)`. The order of `a` and `b` does not matter —
 * the result is always a non-negative integer, since the difference is taken in absolute value.
 * Partial days (any remainder below 86400 seconds) are truncated, not rounded. If `a` and `b`
 * fall on the same day (less than 24 hours apart), the result is `0`.
 *
 * Examples:
 * - `between(DateTime.fromString("2024-01-01T00:00:00Z"), DateTime.fromString("2024-01-03T00:00:00Z"))` -> `2`
 * - `between(DateTime.fromString("2024-01-03T00:00:00Z"), DateTime.fromString("2024-01-01T00:00:00Z"))` -> `2`
 * - `between(DateTime.fromString("2024-01-01T00:00:00Z"), DateTime.fromString("2024-01-01T12:00:00Z"))` -> `0`
 * - `between(DateTime.fromString("2024-01-01T00:00:00Z"), DateTime.fromString("2024-01-01T00:00:00Z"))` -> `0`
 */
type AfTime.DaysBetween {

  /**
   * Computes the number of whole days between two datetimes, regardless of their order.
   *
   * Takes the absolute difference in seconds between `a` and `b` (via `DateTime#deltaSeconds`)
   * and floors the result to the number of complete 24-hour periods it contains. Partial days
   * are truncated, not rounded up.
   *
   * @param a A required datetime; one end of the interval.
   * @param b A required datetime; the other end of the interval.
   * @return The non-negative number of whole days between `a` and `b`.
   */
  between: function(a: !datetime, b: !datetime): !int js-rhino
}
