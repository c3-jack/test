/**
 * AfTime.IsWeekend is a stateless utility service (declared here as a plain `type` because the
 * platform parser rejects the `service type` keyword combination; it is used purely as a
 * stateless service in the "service" sense) for determining whether a given date falls on a
 * weekend.
 *
 * Contract of {@link AfTime.IsWeekend#check}: `date` is the required datetime being tested, using
 * the date's {@link DateTime#dayOfWeek} (1 = Monday ... 7 = Sunday). Saturday (6) and Sunday (7)
 * are considered the weekend and return `true`; Monday-Friday (1-5) return `false`. The year,
 * month, and time-of-day are irrelevant to the result — only the day-of-week component of `date`
 * matters.
 *
 * Examples:
 * - `check(DateTime '2024-01-06')` (a Saturday) -> `true`
 * - `check(DateTime '2024-01-07')` (a Sunday) -> `true`
 * - `check(DateTime '2024-01-08')` (a Monday) -> `false`
 * - `check(DateTime '2024-01-12')` (a Friday) -> `false`
 */
type AfTime.IsWeekend {

  /**
   * Determines whether `date` falls on a weekend (Saturday or Sunday), based solely on its
   * day of week ({@link DateTime#dayOfWeek}).
   *
   * @param date The required datetime to test.
   * @return `true` if `date` falls on Saturday or Sunday, `false` otherwise.
   */
  check: function(date: !datetime): !boolean js-rhino
}
