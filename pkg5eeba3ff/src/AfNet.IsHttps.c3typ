/**
 * Utility service exposing a check for whether a URL uses the HTTPS scheme.
 *
 * {@link AfNet.IsHttps#check} inspects the scheme portion of a URL string
 * and reports whether it is `https`.
 */
service type AfNet.IsHttps {

  /**
   * Determines whether {@link url} uses the `https` scheme.
   *
   * Contract:
   * - Returns `true` if {@link url} starts with `https://` (case-insensitive
   *   on the scheme).
   * - Returns `false` if {@link url} starts with any other scheme (e.g.
   *   `http://`, `ftp://`), has no scheme at all (e.g. a bare hostname or
   *   relative path), or is not a syntactically valid URL.
   * - Leading/trailing whitespace around {@link url} is ignored.
   *
   * @param url the URL string to inspect
   * @return `true` when `url`'s scheme is `https`, `false` otherwise
   */
  check: function(url: !string): !boolean js-rhino
}
