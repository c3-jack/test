/**
 * AfText.TruncateWords is a stateless utility service (declared here as a plain `type` because
 * the platform parser rejects the `service type` keyword combination; it is used purely as a
 * stateless service in the "service" sense) for shortening a string to at most a given number of
 * words, appending an ellipsis when text was actually cut off.
 *
 * Contract of {@link AfText.TruncateWords#truncate}: `input` is a required string, split into
 * words on runs of whitespace (leading/trailing whitespace is ignored, and empty segments from
 * consecutive whitespace are skipped). `maxWords` is a required non-negative integer giving the
 * maximum number of words to keep. If `input` has `maxWords` words or fewer, the words are
 * rejoined with a single space and returned as-is (no trailing ellipsis). If `input` has more
 * than `maxWords` words, the first `maxWords` words are rejoined with a single space and
 * `"..."` is appended, separated by a single space. A `maxWords` of `0` returns `""` when
 * `input` has any words, and `""` when `input` is empty or all whitespace. `input` is never
 * mutated.
 *
 * Examples:
 * - `truncate("the quick brown fox jumps", 3)` -> `"the quick brown ..."`
 * - `truncate("the quick brown", 3)` -> `"the quick brown"`
 * - `truncate("the quick brown", 5)` -> `"the quick brown"`
 * - `truncate("  multiple   spaces   here  ", 2)` -> `"multiple spaces ..."`
 * - `truncate("", 3)` -> `""`
 * - `truncate("word", 0)` -> `""`
 */
type AfText.TruncateWords {

  /**
   * Truncates `input` to at most `maxWords` words, appending `"..."` when words were dropped.
   *
   * Splits `input` on runs of whitespace, discarding empty segments and leading/trailing
   * whitespace. If the resulting word count is less than or equal to `maxWords`, the words are
   * rejoined with single spaces and returned unchanged (no ellipsis). Otherwise the first
   * `maxWords` words are rejoined with single spaces and `" ..."` is appended. `input` is not
   * mutated.
   *
   * @param input A required string to truncate.
   * @param maxWords A required non-negative integer: the maximum number of words to retain.
   * @return `input` truncated to at most `maxWords` words, with `"..."` appended if truncated.
   */
  truncate: function(input: !string, maxWords: !int): !string js-rhino
}
