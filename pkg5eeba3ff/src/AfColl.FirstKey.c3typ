/**
 * Utility service exposing retrieval of an object's first key.
 *
 * {@link AfColl.FirstKey#first} returns the first own enumerable key of a
 * JavaScript object (or the first index of an array), in insertion order.
 */
service type AfColl.FirstKey {

  /**
   * Returns the first own enumerable key of `obj`, in insertion
   * (enumeration) order.
   *
   * Contract:
   * - `obj` is expected to be a non-null JavaScript object; this includes
   *   plain objects and arrays (whose keys are their numeric indices as
   *   strings, e.g. `'0'`).
   * - Own enumerable keys are considered in the same order `Object.keys`
   *   would return them; the first such key is returned.
   * - If `obj` has no own enumerable keys (e.g. `{}` or `[]`), `null` is
   *   returned.
   * - If `obj` is `null` or `undefined`, an Error is thrown.
   *
   * @param obj the object (or array) to read the first key from
   * @return the first own enumerable key of `obj` as a string, or `null`
   *   if `obj` has no keys
   */
  first: function(obj: !any): string js-rhino
}
