/**
 * AfMath.Median is a stateless utility service (declared here as a plain `type` because
 * the platform parser rejects the `service type` keyword combination; it is used purely as a
 * stateless service in the "service" sense) for computing the statistical median of a list of
 * numbers.
 *
 * Contract of {@link AfMath.Median#median}: `values` is a required array of doubles containing
 * one or more numbers, in any order. The function does not mutate `values` — it copies and sorts
 * the values numerically ascending, then returns the middle element for an odd-length list, or
 * the arithmetic mean of the two middle elements for an even-length list. An empty `values` array
 * is invalid input and results in a thrown error, since the median of zero numbers is undefined.
 *
 * Examples:
 * - `median([3, 1, 2])` -> `2`
 * - `median([4, 1, 3, 2])` -> `2.5`
 * - `median([5])` -> `5`
 * - `median([2, 2, 2])` -> `2`
 * - `median([-1, -5, 3])` -> `-1`
 */
type AfMath.Median {

  /**
   * Computes the median of `values`.
   *
   * Copies `values` (leaving the original array unmutated), sorts the copy numerically in
   * ascending order, and returns the single middle element when the count of values is odd, or
   * the average of the two middle elements when the count is even.
   *
   * @param values A required, non-empty array of doubles to compute the median of.
   * @return The median of `values`.
   */
  median: function(values: ![double]): !double js-rhino
}
