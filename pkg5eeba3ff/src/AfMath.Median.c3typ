/**
 * AfMath.Median is a stateless utility service for computing the statistical median of a
 * collection of numeric values.
 *
 * Contract of {@link AfMath.Median#median}: `values` is a required, non-empty array of doubles.
 * The input array is never mutated — the function sorts a copy in ascending numeric order and
 * then returns:
 * - the middle element, if the (sorted) array has an odd length;
 * - the arithmetic mean of the two middle elements, if the array has an even length.
 *
 * The array must contain at least one element; calling {@link AfMath.Median#median} with an
 * empty array throws an error.
 *
 * Examples:
 * - `median([3, 1, 2])` -> `2` (odd length, middle of `[1, 2, 3]`)
 * - `median([1, 2, 3, 4])` -> `2.5` (even length, mean of the two middle values `2` and `3`)
 * - `median([5])` -> `5`
 */
type AfMath.Median {

  /**
   * Computes the median of a non-empty array of doubles.
   *
   * Sorts a copy of `values` in ascending numeric order (the original array is not mutated)
   * and returns the middle value for an odd-length array, or the arithmetic mean of the two
   * middle values for an even-length array.
   *
   * @param values A required, non-empty array of doubles to compute the median of.
   * @return The median of `values`.
   * @throws if `values` is empty.
   */
  median: function(values: ![double]): !double js-rhino
}
